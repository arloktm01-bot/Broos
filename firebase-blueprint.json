{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Marker document identifying an administrator UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Authorized read-only or admin member in the shared accounting workspace",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "role": {
          "type": "string",
          "enum": ["admin", "viewer"],
          "minLength": 4,
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "role", "createdAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Shared accounting workspace configuration",
      "type": "object",
      "properties": {
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "pettyCashLimit": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["businessName", "currency", "pettyCashLimit", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Tracked SKU inventory item",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "totalStockLevel": { "type": "number" },
        "stockRemaining": { "type": "number" },
        "unitCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "sku",
        "name",
        "category",
        "totalStockLevel",
        "stockRemaining",
        "unitCost",
        "sellingPrice",
        "reorderLevel",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "General ledger accounting transaction",
      "type": "object",
      "properties": {
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "type": { "type": "string", "enum": ["sale", "purchase", "petty_cash_expense", "operating_expense", "petty_cash_replenish"], "minLength": 4, "maxLength": 30 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Bank Transfer", "Card", "Cash", "Petty Cash"], "minLength": 4, "maxLength": 20 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 40 },
        "skuId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "cogs": { "type": "number" },
        "budgetBucketId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recurringRuleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "notes": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "type", "description", "category", "amount", "paymentMethod", "reference", "createdAt", "updatedAt"]
    },
    "BudgetRule": {
      "title": "BudgetRule",
      "description": "Net income allocation percentage rule",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 0, "maxLength": 240 },
        "percentage": { "type": "number" },
        "color": { "type": "string", "minLength": 4, "maxLength": 20 },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "percentage", "color", "sortOrder", "createdAt", "updatedAt"]
    },
    "RecurringRule": {
      "title": "RecurringRule",
      "description": "Scheduled recurring transaction rule",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["sale", "purchase", "petty_cash_expense", "operating_expense", "petty_cash_replenish"], "minLength": 4, "maxLength": 30 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Bank Transfer", "Card", "Cash", "Petty Cash"], "minLength": 4, "maxLength": 20 },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"], "minLength": 5, "maxLength": 10 },
        "startDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "nextRunDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "endDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "approvalMode": { "type": "string", "enum": ["auto_post", "manual_review"], "minLength": 9, "maxLength": 15 },
        "active": { "type": "boolean" },
        "budgetBucketId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "skuId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quantity": { "type": "number" },
        "lastPostedDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "totalPostedCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "description", "category", "amount", "paymentMethod", "frequency", "startDate", "nextRunDate", "approvalMode", "active", "totalPostedCount", "createdAt", "updatedAt"]
    },
    "PendingRecurringEntry": {
      "title": "PendingRecurringEntry",
      "description": "Recurring occurrence queued for manual review prior to posting",
      "type": "object",
      "properties": {
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scheduledDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "type": { "type": "string", "enum": ["sale", "purchase", "petty_cash_expense", "operating_expense", "petty_cash_replenish"], "minLength": 4, "maxLength": 30 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Bank Transfer", "Card", "Cash", "Petty Cash"], "minLength": 4, "maxLength": 20 },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"], "minLength": 5, "maxLength": 10 },
        "budgetBucketId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "skuId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quantity": { "type": "number" },
        "note": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ruleId", "scheduledDate", "type", "description", "category", "amount", "paymentMethod", "frequency", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Administrator role lookup documents"
    },
    "/members/{userId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Authorized workspace members (admin and read-only viewer)"
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Shared accounting workspace settings"
    },
    "/workspaces/{workspaceId}/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Workspace inventory SKUs"
    },
    "/workspaces/{workspaceId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Workspace general ledger transactions"
    },
    "/workspaces/{workspaceId}/budgetRules/{ruleId}": {
      "schema": { "$ref": "#/entities/BudgetRule" },
      "description": "Workspace net income budget allocation rules"
    },
    "/workspaces/{workspaceId}/recurringRules/{ruleId}": {
      "schema": { "$ref": "#/entities/RecurringRule" },
      "description": "Workspace recurring transaction schedules"
    },
    "/workspaces/{workspaceId}/pendingRecurring/{pendingId}": {
      "schema": { "$ref": "#/entities/PendingRecurringEntry" },
      "description": "Workspace pending recurring entries awaiting admin approval"
    }
  }
}
